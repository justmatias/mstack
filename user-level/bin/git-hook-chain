#!/usr/bin/env bash
# Global git hook (core.hooksPath = $MY_RULES_HOME/githooks). Every standard hook
# name in githooks/ is a symlink to this script. It runs the personal set on
# pre-commit, then chains to the repo's own hooks so none of them is lost:
#   1. .git/hooks/<name>, when it exists, is executable and was not generated by pre-commit;
#   2. pre-commit, when the repo has .pre-commit-config.yaml and pre-commit would have
#      installed this hook type (default_install_hook_types, or a pre-commit-generated
#      script already in .git/hooks/<name>).
# The exit code is the worst of all of them.
set -uo pipefail

hook_name="$(basename "$0")"
home="${MY_RULES_HOME:-$HOME/.config/my-rules}"
status=0

stdin_copy="$(mktemp)"
trap 'rm -f "$stdin_copy"' EXIT
if [[ ! -t 0 ]]; then cat > "$stdin_copy"; fi

repository_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
git_directory="$(git rev-parse --absolute-git-dir 2>/dev/null || echo "$repository_root/.git")"
local_hook="$git_directory/hooks/$hook_name"

if [[ "$hook_name" == "pre-commit" && "${MY_RULES_DISABLE:-}" != "1" ]]; then
  staged=()
  while IFS= read -r file; do
    [[ -n "$file" ]] && staged+=("$repository_root/$file")
  done < <(git diff --cached --name-only --diff-filter=ACM)
  if (( ${#staged[@]} )); then
    "$home/bin/my-rules-check" "${staged[@]}" || status=1
  fi
fi

generated_by_pre_commit() {
  [[ -f "$1" ]] && grep -q "File generated by pre-commit" "$1"
}

if [[ -x "$local_hook" ]] && ! generated_by_pre_commit "$local_hook"; then
  "$local_hook" "$@" < "$stdin_copy" || status=$?
fi

pre_commit_types="commit-msg post-checkout post-commit post-merge post-rewrite pre-commit pre-merge-commit pre-push pre-rebase prepare-commit-msg"
config="$repository_root/.pre-commit-config.yaml"
if [[ -f "$config" && " $pre_commit_types " == *" $hook_name "* ]]; then
  install_types="$(python3 - "$config" <<'PY'
import re, sys
text = open(sys.argv[1], encoding="utf-8").read()
match = re.search(r"^default_install_hook_types:\s*(\[.*?\]|(?:\n\s*-\s*\S+)+)", text, re.MULTILINE)
print(" ".join(re.findall(r"[\w-]+", match[1])) if match else "pre-commit")
PY
)"
  if [[ " $install_types " == *" $hook_name "* ]] || generated_by_pre_commit "$local_hook"; then
    if [[ -x "$repository_root/.venv/bin/pre-commit" ]]; then
      pre_commit=("$repository_root/.venv/bin/pre-commit")
    elif command -v pre-commit >/dev/null; then
      pre_commit=(pre-commit)
    elif command -v uv >/dev/null && [[ -f "$repository_root/uv.lock" ]]; then
      pre_commit=(uv run --project "$repository_root" pre-commit)
    else
      echo "git-hook-chain: $config exists but pre-commit is not installed" >&2
      exit 1
    fi
    (cd "$repository_root" && "${pre_commit[@]}" hook-impl --config=.pre-commit-config.yaml \
      --hook-type="$hook_name" --hook-dir "$git_directory/hooks" --skip-on-missing-config -- "$@" \
      < "$stdin_copy") || status=$?
  fi
fi

exit "$status"
