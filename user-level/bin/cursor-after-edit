#!/usr/bin/env bash
# Cursor user-level postToolUse hook, installed with no matcher: it runs after every
# tool and acts only when the tool input names an existing file. Same logic as
# claude-post-edit; findings go back to the agent as additional_context
# (afterFileEdit output does not). MSTACK_HOOK_DEBUG=1 appends the tool name and
# input keys of every call to $MSTACK_HOOK_DEBUG_LOG (default: mstack-hooks.log
# in the temp dir), to see which tools a real Cursor session sends.
set -uo pipefail
home="${MY_RULES_HOME:-$HOME/.config/my-rules}"
if [[ "${MY_RULES_DISABLE:-}" == "1" ]]; then echo '{}'; exit 0; fi

payload="$(cat)"
file="$(printf '%s' "$payload" | python3 -c '
import datetime, json, os, sys, tempfile
payload = json.load(sys.stdin)
tool_input = payload.get("tool_input") or {}
if isinstance(tool_input, str):
    try:
        tool_input = json.loads(tool_input)
    except ValueError:
        tool_input = {}
if not isinstance(tool_input, dict):
    tool_input = {}
if os.environ.get("MSTACK_HOOK_DEBUG") == "1":
    log = os.environ.get("MSTACK_HOOK_DEBUG_LOG") or os.path.join(
        tempfile.gettempdir(), "mstack-hooks.log"
    )
    try:
        with open(log, "a", encoding="utf-8") as stream:
            stream.write(" ".join([
                datetime.datetime.now().isoformat(timespec="seconds"),
                "cursor-after-edit",
                "tool=" + str(payload.get("tool_name")),
                "input_keys=" + ",".join(sorted(tool_input)),
            ]) + "\n")
    except OSError:
        pass
for key in ("file_path", "path", "target_file"):
    if tool_input.get(key) or payload.get(key):
        print(tool_input.get(key) or payload.get(key))
        break
' 2>/dev/null)"
if [[ -z "$file" || ! -f "$file" ]]; then echo '{}'; exit 0; fi

with_repo="--with-repo"
root="$(cd "$(dirname "$file")" && git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -n "$root" ]] && grep -qs "cursor_after_edit.sh" "$root/.cursor/hooks.json"; then
  with_repo=""
fi

if output="$(cd "$(dirname "$file")" && "$home/bin/my-rules-check" $with_repo "$file" 2>&1)"; then
  echo '{}'
else
  python3 -c 'import json, sys; print(json.dumps({"additional_context": sys.argv[1]}))' \
    "my-rules: $file breaks a rule. Fix it before continuing:
$output"
fi
exit 0
