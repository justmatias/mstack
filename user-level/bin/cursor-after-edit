#!/usr/bin/env bash
# Cursor user-level postToolUse hook (matcher Write). Same logic as claude-post-edit;
# findings go back to the agent as additional_context (afterFileEdit output does not).
set -uo pipefail
home="${MY_RULES_HOME:-$HOME/.config/my-rules}"
if [[ "${MY_RULES_DISABLE:-}" == "1" ]]; then echo '{}'; exit 0; fi

payload="$(cat)"
file="$(printf '%s' "$payload" | python3 -c '
import json, sys
payload = json.load(sys.stdin)
tool_input = payload.get("tool_input") or {}
if isinstance(tool_input, str):
    try:
        tool_input = json.loads(tool_input)
    except ValueError:
        tool_input = {}
for key in ("file_path", "path", "target_file"):
    if tool_input.get(key) or payload.get(key):
        print(tool_input.get(key) or payload.get(key))
        break
')"
if [[ -z "$file" || ! -f "$file" ]]; then echo '{}'; exit 0; fi

with_repo="--with-repo"
root="$(cd "$(dirname "$file")" && git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -n "$root" ]] && grep -qs "cursor_after_edit.sh" "$root/.cursor/hooks.json"; then
  with_repo=""
fi

if output="$(cd "$(dirname "$file")" && "$home/bin/my-rules-check" $with_repo "$file" 2>&1)"; then
  echo '{}'
else
  python3 -c 'import json, sys; print(json.dumps({"additional_context": sys.argv[1]}))' \
    "my-rules: $file breaks a rule. Fix it before continuing:
$output"
fi
exit 0
