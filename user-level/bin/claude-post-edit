#!/usr/bin/env bash
# Claude Code user-level PostToolUse hook (matcher Edit|Write). Runs the personal set,
# plus the repo's lint-rules when the repo has no project hook of its own, on the
# edited file. On errors, prints them to stderr and exits 2 so Claude sees them.
set -uo pipefail
[[ "${MY_RULES_DISABLE:-}" == "1" ]] && exit 0
home="${MY_RULES_HOME:-$HOME/.config/my-rules}"

file="$(python3 -c '
import json, sys
tool_input = json.load(sys.stdin).get("tool_input") or {}
print(tool_input.get("file_path") or "")
')"
[[ -n "$file" && -f "$file" ]] || exit 0

project="${CLAUDE_PROJECT_DIR:-}"
with_repo="--with-repo"
if [[ -n "$project" ]] && grep -qs "claude_post_edit.sh" "$project/.claude/settings.json" "$project/.claude/settings.local.json"; then
  with_repo=""  # the repo's own project hook already runs its lint-rules
fi

if ! output="$(cd "$(dirname "$file")" && "$home/bin/my-rules-check" $with_repo "$file" 2>&1)"; then
  printf 'my-rules: %s breaks a rule. Fix it before continuing:\n%s\n' "$file" "$output" >&2
  exit 2
fi
exit 0
